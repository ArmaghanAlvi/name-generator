# Template for .env.production (publishing Stage 3f).
# Copy to .env.production ON THE MACHINE THAT RUNS THE STACK and fill it in.
# .env.production is gitignored. Real values exist only on the server.
# Use long alphanumeric passwords (e.g. `openssl rand -hex 32`): special
# characters would need URL-encoding inside DATABASE_URL.

SITE_ADDRESS=localhost
POSTGRES_DB=name_generator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Stage 2d switches the app to the least-privilege nameforge_app role.
DATABASE_URL=postgresql+psycopg://postgres:change-me@db:5432/name_generator
SENTRY_DSN=
IMAGE_TAG=latest

# Sized in Stage 6 from the Stage 2e numbers.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_MAINTENANCE_WORK_MEM=512MB
DB_MEMORY_LIMIT=6g
BACKEND_MEMORY_LIMIT=3g
