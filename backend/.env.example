DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/name_generator
ROOT_LLM_API_KEY=
ROOT_LLM_MODEL=gemini-flash-lite-latest
ROOT_LLM_RPM=8
# Query-time trickle. Default ON since Stage 17d; set to 0 to disable.
# Harnesses fence themselves regardless (tests/test_llm_fence.py).
ROOT_LLM_QUERY_TIME=1

# --- Publishing Stage 3 (optional locally; production sets APP_ENV=production) ---
# APP_ENV=local
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# PREWARM_ON_STARTUP=1
# Leave these three unset to derive them from APP_ENV:
# EXPOSE_API_DOCS=1
# ALLOW_INCLUDE_HIDDEN=1
# RATE_LIMIT_ENABLED=0
# RATE_LIMIT_EXPLORE_PER_MINUTE=20
# RATE_LIMIT_LOOKUP_PER_MINUTE=120
# ALLOW_QUERY_TIME_LLM_IN_PRODUCTION=0
# SENTRY_DSN=

# --- Publishing Stage 1 (optional; unset = today's behaviour) ---
# Unset auto-detects mps, then cuda, then cpu. An explicit device that isn't
# available fails at model load instead of falling back.
# EMBEDDING_DEVICE=cpu
# Torch intra-op threads, set before the model loads. Unset = torch default.
# TORCH_NUM_THREADS=2
